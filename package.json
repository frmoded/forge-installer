{
  "name": "forge-installer",
  "version": "0.1.0",
  "description": "One-paste install for the Forge Client plugin (BRAT-friendly bootstrap).",
  "main": "main.js",
  "scripts": {
    "build": "npx esbuild src/main.ts --bundle --platform=node --external:obsidian --external:@codemirror/view --external:@codemirror/state --format=cjs --outfile=main.js",
    "dev": "npm run build -- --watch",
    "test": "node --test src/*.test.ts"
  },
  "keywords": [],
  "author": "Oded Fuhrmann",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
